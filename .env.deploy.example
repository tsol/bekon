# Copy to .env.deploy (gitignored) for relay deploy / publish-apk.
# Used by: npm run relay:deploy, npm run relay:publish-apk

DEPLOY_USER=root
DEPLOY_HOST=relay.example
DEPLOY_DIR=/opt/wlya-server/app
DEPLOY_HEALTH=https://relay.example/health

# Optional — leave empty to use SSH keys or interactive prompt
# SSH_PASS=

# Local relay dev (npm run relay:start)
# PORT=18081
# REDIS_URL=redis://127.0.0.1:6379
